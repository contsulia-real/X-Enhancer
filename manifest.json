{
  "manifest_version": 3,
  "name": "𝕏 Enhancer",
  "version": "0.1.0",
  "description": "为 X 保存本地浏览历史、筛选回复、展示推荐算法资料并隐藏侧栏直播，支持简繁中文、日语、韩语、英语和法语。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
